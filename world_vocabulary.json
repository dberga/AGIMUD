    "IDLE", "PATROLLING", "GUARDING", "HUNTING", "RESTING",
    "TRAVELING", "COMBAT", "FLEEING", "SEARCHING", "FOLLOWING",
    "EXPLORE", "SOCIALIZE", "GATHER", "SHARE"
  ],
  "ekman_emotions": [
    "anger", "fear", "disgust", "sadness", "joy", "surprise"
  ],
  "emotion_intensities": {
    "anger": ["irritated", "frustrated", "angry", "furious", "rage"],
    "fear": ["uneasy", "apprehensive", "fearful", "terrified", "petrified"],
    "disgust": ["disapproving", "repulsed", "disgusted", "revolted", "horrified"],
    "sadness": ["gloomy", "sad", "grieving", "despondent", "heartbroken"],
    "joy": ["content", "happy", "delighted", "joyous", "ecstatic"],
    "surprise": ["puzzled", "surprised", "amazed", "astonished", "shocked"]
  },
  "emotion_appraisal_map": {
    "goal_blocked": "anger",
    "threat_detected": "fear",
    "contamination_detected": "disgust",
    "loss_experienced": "sadness",
    "goal_achieved": "joy",
    "novelty_detected": "surprise"
  },
  "emotion_intensity_adjustments": {
    "health_low": 0.3,
    "stamina_low": 0.3,
    "health_high": -0.2,
    "stamina_high": -0.2
  },
  "goal_hierarchy": {
	  "survival": {
		"triggers": ["hunger > 70", "thirst > 70", "health < 30", "stamina < 30"],
		"priority": 1,
		"min_duration_ticks": 1, "max_duration_ticks": 120
	  },
	  "social_belonging": {
		"triggers": ["morale < 30", "emotional_state == joy", "emotional_state == sadness"],
		"priority": 2,
		"min_duration_ticks": 10, "max_duration_ticks": 720
	  },
	  "exploration": {
		"triggers": ["stamina > 60", "emotional_state == surprise", "stamina > 50 AND morale > 50"],
		"priority": 3,
		"min_duration_ticks": 5, "max_duration_ticks": 360
	  },
	  "power_achievement": {
		"triggers": ["emotional_state == anger", "health > 50", "achievement > 0.5"],
		"priority": 4,
		"min_duration_ticks": 20, "max_duration_ticks": 1440
	  },
	  "knowledge_acquisition": {
		"triggers": ["stamina > 50", "health > 50", "morale > 50"],
		"priority": 5,
		"min_duration_ticks": 30, "max_duration_ticks": 2880
	  },
	  "altruism": {
		"triggers": ["benevolence > 0.5", "has_allies", "emotional_state == joy"],
		"priority": 6,
		"min_duration_ticks": 15, "max_duration_ticks": 720
	  }
	},
  "condition_registry": {
    "has_allies": {
      "type": "function",
      "description": "Character has allies",
      "evaluation": "len(known_characters) > 0 AND any(trust > 0.6)"
    },
    "enemy_nearby": {
      "type": "function",
      "description": "Enemy detected nearby",
      "evaluation": "any(relationship == enemy AND distance < 10)"
    },
    "enemy_defeated": {
      "type": "flag",
      "description": "Enemy has been defeated",
      "flag_name": "enemy_defeated"
    },
    "safe": {
      "type": "flag",
      "description": "Character is in a safe zone",
      "flag_name": "safe"
    },
    "door_open": {
      "type": "state",
      "description": "Door is open",
      "state_key": "door_open"
    },
    "has_key": {
      "type": "function",
      "description": "Character has a key",
      "evaluation": "any(item == key in contained_objects)"
    },
    "boss_defeated": {
      "type": "flag",
      "description": "Boss has been defeated",
      "flag_name": "boss_defeated"
    },
    "threat_nearby": {
      "type": "function",
      "description": "Threat detected nearby",
      "evaluation": "any(threat_level > 0.5 AND distance < 20)"
    },
    "ally_attacked": {
      "type": "flag",
      "description": "Ally has been attacked",
      "flag_name": "ally_attacked"
    },
    "resources_excess": {
      "type": "function",
      "description": "Has excess resources",
      "evaluation": "len(contained_objects) > 3"
    }
  },
